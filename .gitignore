# =====================================================================
# .gitignore for ThisIsLogic (Unreal Engine 5, C++ project)
#
# Rule of thumb: only files that Unreal Engine or the IDE cannot
# regenerate belong in the repository:
#   ThisIsLogic.uproject, Config/, Source/, Content/ (and Plugins/, if any)
# =====================================================================

# ---------------------------------------------------------------------
# Folders generated by Unreal Engine
# (no leading slash: also matches the same folders inside Plugins/)
# ---------------------------------------------------------------------
Binaries/
Intermediate/
Saved/
DerivedDataCache/

# ---------------------------------------------------------------------
# Build/ folder: ignored, except custom icons
# ---------------------------------------------------------------------
/Build/*
!/Build/*/
/Build/*/**
!/Build/**/*.ico

# ---------------------------------------------------------------------
# Lighting data generated when building maps (can be rebuilt)
# ---------------------------------------------------------------------
*_BuiltData.uasset

# ---------------------------------------------------------------------
# Packaged builds (if you package the game inside the project folder,
# point the output to Packaged/)
# ---------------------------------------------------------------------
/Packaged/

# ---------------------------------------------------------------------
# Visual Studio (regenerated by "Generate Visual Studio project files")
# ---------------------------------------------------------------------
.vs/
*.sln
*.slnx
*.suo
*.user
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
.vsconfig

# ---------------------------------------------------------------------
# Other IDEs and editors
# ---------------------------------------------------------------------
.idea/
*.sln.DotSettings.user
.vscode/
*.code-workspace
*.xcodeproj
*.xcworkspace
compile_commands.json

# ---------------------------------------------------------------------
# Stray build artifacts (extra safety; normally inside Binaries/ or
# Intermediate/). If you ever add a third-party library that ships
# .lib/.dll files, add exceptions for it here.
# ---------------------------------------------------------------------
*.obj
*.o
*.pch
*.gch
*.pdb
*.ilk
*.exp
*.lib
*.dll
*.exe
*.so
*.dylib
*.a

# ---------------------------------------------------------------------
# Profiling captures, crash dumps and temporary files
# ---------------------------------------------------------------------
*.utrace
*.dmp
*.tmp

# ---------------------------------------------------------------------
# Operating system files
# ---------------------------------------------------------------------
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
.DS_Store
